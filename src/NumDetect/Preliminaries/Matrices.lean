import NumDetect.Preliminaries.Basic
import General.MatrixAnalysis.RowDeletion
import Mathlib.Analysis.CStarAlgebra.Matrix

/-! Generalized Hankel/Toeplitz and Vandermonde matrices, Euclidean norms, and rank. -/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

open Matrix WithLp
open scoped BigOperators

namespace LeanNumDetect
namespace NumDetect

noncomputable section

/-- Steering vector for an ordered finite frequency family. -/
def steeringVector {d : ℕ} {ι : Type*} (frequency : ι → Point d)
    (y : Point d) : ι → ℂ :=
  fun i => Complex.exp (Complex.I * (dot (frequency i) y : ℂ))

/-- Generalized Vandermonde matrix `𝓥_Γ(𝓧)`. -/
def generalizedVandermonde {d n : ℕ} {ι : Type*}
    (frequency : ι → Point d) (node : Fin n → Point d) :
    Matrix ι (Fin n) ℂ :=
  fun i j => steeringVector frequency (node j) i

/-- Generalized Hankel matrix for a function whose domain is an arbitrary set `𝓓`,
including the manuscript's hypothesis `𝓐 + 𝓑 ⊆ 𝓓`. -/
def generalizedHankelOn {d : ℕ} {ι κ : Type*}
    (rowFrequency : ι → Point d) (columnFrequency : κ → Point d)
    (domain : Set (Point d)) (f : domain → ℂ)
    (hadd : ∀ i j, rowFrequency i + columnFrequency j ∈ domain) :
    Matrix ι κ ℂ :=
  fun i j => f ⟨rowFrequency i + columnFrequency j, hadd i j⟩

/-- Generalized Toeplitz matrix for a function whose domain is an arbitrary set `𝓓`,
including the manuscript's hypothesis `𝓐 - 𝓑 ⊆ 𝓓`. -/
def generalizedToeplitzOn {d : ℕ} {ι κ : Type*}
    (rowFrequency : ι → Point d) (columnFrequency : κ → Point d)
    (domain : Set (Point d)) (f : domain → ℂ)
    (hsub : ∀ i j, rowFrequency i - columnFrequency j ∈ domain) :
    Matrix ι κ ℂ :=
  fun i j => f ⟨rowFrequency i - columnFrequency j, hsub i j⟩

/-- Generalized Hankel matrix generated by `f` and two ordered frequency families. -/
def generalizedHankel {d : ℕ} {ι κ : Type*}
    (rowFrequency : ι → Point d) (columnFrequency : κ → Point d)
    (f : Point d → ℂ) : Matrix ι κ ℂ :=
  fun i j => f (rowFrequency i + columnFrequency j)

/-- Generalized Toeplitz matrix generated by `f` and two ordered frequency families. -/
def generalizedToeplitz {d : ℕ} {ι κ : Type*}
    (rowFrequency : ι → Point d) (columnFrequency : κ → Point d)
    (f : Point d → ℂ) : Matrix ι κ ℂ :=
  fun i j => f (rowFrequency i - columnFrequency j)

/-- The manuscript's Hankel-type Vandermonde factorization. -/
def hankelVandermondeFactor {d n : ℕ} {ι κ : Type*}
    [Fintype (Fin n)] [DecidableEq (Fin n)]
    (rowFrequency : ι → Point d) (columnFrequency : κ → Point d)
    (μ : AtomicMeasure d n) : Matrix ι κ ℂ :=
  generalizedVandermonde rowFrequency μ.node *
    Matrix.diagonal μ.amplitude *
    (generalizedVandermonde columnFrequency μ.node)ᵀ

/-- The manuscript's Toeplitz-type Vandermonde factorization. -/
def toeplitzVandermondeFactor {d n : ℕ} {ι κ : Type*}
    [Fintype (Fin n)] [DecidableEq (Fin n)]
    (rowFrequency : ι → Point d) (columnFrequency : κ → Point d)
    (μ : AtomicMeasure d n) : Matrix ι κ ℂ :=
  generalizedVandermonde rowFrequency μ.node *
    Matrix.diagonal μ.amplitude *
    (generalizedVandermonde columnFrequency μ.node)ᴴ

/-- A matrix admits either one of the two generalized Vandermonde decompositions. -/
def AdmitsGeneralizedVandermondeDecomposition {d : ℕ} {ι κ : Type*}
    (rowFrequency : ι → Point d) (columnFrequency : κ → Point d)
    (A : Matrix ι κ ℂ) : Prop :=
  ∃ (n : ℕ) (μ : AtomicMeasure d n),
    A = hankelVandermondeFactor rowFrequency columnFrequency μ ∨
    A = toeplitzVandermondeFactor rowFrequency columnFrequency μ

/-- Spectral/operator norm induced by Euclidean norms. -/
def matrixSpectralNorm {ι κ : Type*} [Fintype ι] [Fintype κ]
    [DecidableEq κ] (A : Matrix ι κ ℂ) : ℝ :=
  ‖(Matrix.toEuclideanLin.trans LinearMap.toContinuousLinearMap) A‖

/-- Full column rank of a finite matrix. -/
def HasFullColumnRank {ι κ : Type*} [Fintype κ]
    (A : Matrix ι κ ℂ) : Prop :=
  Function.Injective A.mulVecLin

end

end NumDetect
end LeanNumDetect
